# Get a key at https://agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=

# Optional: where get_hackathon_changes stores its previous observation
# WEMAKEDEVS_MCP_STATE_DIR=~/.cache/wemakedevs-mcp

# Optional: the Streamable HTTP transport (HOST=127.0.0.1 means no token is needed)
# HOST=127.0.0.1
# PORT=3000
# MCP_HTTP_TOKEN=              # required to bind any non-loopback address
# MCP_HTTP_HOSTS=              # extra allowed Host values, comma-separated
# MCP_HTTP_ORIGINS=            # extra allowed Origin values, comma-separated
