{
  "name": "wemakedevs-mcp",
  "version": "0.1.0",
  "description": "MCP server that turns wemakedevs.org (hackathons, meetups, scholarships, careers) into typed agent tools. TinyFish reads the live site; no canned data.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "wemakedevs-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --experimental-strip-types src/index.ts",
    "start": "node dist/index.js",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "health": "npm run build && node dist/src/healthcli.js",
    "stub": "node scripts/stub-tinyfish.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cheerio": "^1.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tinyfish",
    "wemakedevs",
    "hackathons",
    "agent-tools"
  ]
}