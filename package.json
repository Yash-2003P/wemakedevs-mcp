{
  "name": "wemakedevs-mcp",
  "version": "0.1.0",
  "description": "16 typed MCP tools for wemakedevs.org — hackathons, timelines, resources, rules, blogs, meetups, scholarships and careers — read live via TinyFish. No canned data.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "wemakedevs-mcp": "./dist/src/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --experimental-strip-types src/index.ts",
    "start": "node dist/src/index.js",
    "test": "npm run build && node scripts/test.mjs",
    "health": "npm run build && node dist/src/healthcli.js",
    "stub": "node scripts/stub-tinyfish.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "smoke:all": "npm run build && node scripts/smoke.mjs --all",
    "start:http": "node dist/src/http.js",
    "smoke:http": "npm run build && node scripts/smoke-http.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "cheerio": "^1.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "tinyfish",
    "wemakedevs",
    "hackathons",
    "blogs",
    "agent-tools"
  ]
}
